{
  "name": "@hagicode/hagitask",
  "version": "0.1.0",
  "description": "Offline HagiTask package schemas, validation API, and CLI.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "hagitask": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HagiCode-org/hagitask.git"
  },
  "homepage": "https://github.com/HagiCode-org/hagitask",
  "bugs": {
    "url": "https://github.com/HagiCode-org/hagitask/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "validate": "npm run build && node dist/cli.js validate .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "commander": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.3"
  }
}
