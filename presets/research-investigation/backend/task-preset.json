{
  "$schema": "../../../schemas/task-preset-plugin/task-preset.schema.json",
  "taskKey": "researchInvestigation",
  "scriptKey": "autotask.research-investigation",
  "defaultTargetType": "vault",
  "execution": {
    "schemaVersion": "1.0",
    "strategy": "declarative"
  },
  "compatibility": {
    "deprecatedInputs": [
      {
        "legacy": "ResearchDirection",
        "binding": "researchDirection",
        "diagnosticCode": "legacy-input-mapped"
      },
      {
        "legacy": "RepositoryUrls",
        "binding": "repositoryUrls",
        "diagnosticCode": "legacy-input-mapped"
      }
    ]
  },
  "requirements": [
    {
      "type": "agent",
      "name": "any"
    }
  ],
  "targets": {
    "repositories": {
      "enabled": false
    },
    "vaults": {
      "enabled": false
    },
    "projects": {
      "enabled": false
    }
  },
  "inputBindings": [
    {
      "input": "researchDirection",
      "promptParameter": "researchDirection",
      "metadataKey": "autoTaskResearchDirection",
      "required": true,
      "valueType": "text",
      "transform": "trim",
      "aliases": [
        "ResearchDirection"
      ]
    },
    {
      "input": "repositoryUrls",
      "promptParameter": "repositoryUrls",
      "metadataKey": "autoTaskResearchRepositoryUrls",
      "valueType": "multiple",
      "transform": "url-list",
      "aliases": [
        "RepositoryUrls"
      ]
    }
  ]
}
