{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hagicode.local/designs/task-preset-plugin-schemas/store-page-frontmatter.schema.json",
  "title": "Task Preset Store Page Frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "locale",
    "slug",
    "title",
    "summary",
    "status"
  ],
  "properties": {
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "eyebrow": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "experimental",
        "disabled"
      ]
    },
    "primaryCtaLabel": {
      "type": "string"
    },
    "secondaryCtaLabel": {
      "type": "string"
    },
    "catalog": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/filterKey"
      },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "filterKey": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    }
  }
}
