{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hagicode.local/designs/task-preset-plugin-schemas/task-preset.schema.json",
  "title": "Task Preset Plugin Backend Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskKey", "scriptKey", "defaultTargetType", "targets", "inputBindings"],
  "properties": {
    "$schema": {"type": "string"},
    "taskKey": {"type": "string", "minLength": 1},
    "scriptKey": {"type": "string", "minLength": 1},
    "defaultTargetType": {"enum": ["repository", "vault", "project"]},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories", "vaults", "projects"],
      "properties": {
        "repositories": {"$ref": "#/$defs/targetCollection"},
        "vaults": {"$ref": "#/$defs/targetCollection"},
        "projects": {"$ref": "#/$defs/targetCollection"}
      }
    },
    "inputBindings": {"type": "array", "items": {"$ref": "#/$defs/inputBinding"}},
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "defaultSceneKey", "registrations"],
      "properties": {
        "provider": {"type": "string"},
        "defaultSceneKey": {"type": "string"},
        "registrations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sceneRegistration"}}
      }
    },
    "execution": {"$ref": "#/$defs/execution"},
    "compatibility": {"$ref": "#/$defs/compatibility"}
  },
  "$defs": {
    "targetCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "selections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/selection"}}
      },
      "allOf": [{
        "if": {"properties": {"enabled": {"const": true}}},
        "then": {"required": ["selections"]}
      }]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "selectionMode", "output"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "selectionMode": {"enum": ["single", "multiple"]},
        "allowedAccessTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["read", "write"]}
        },
        "accessType": {"enum": ["read", "write"]},
        "required": {"type": "boolean"},
        "output": {"type": "string", "minLength": 1},
        "mutuallyExclusiveWith": {"type": "array", "items": {"type": "string"}},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source"],
          "properties": {
            "source": {"enum": ["owner-project-repositories", "vault-registry", "project-registry"]},
            "allowedVaultTypes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
            "includeSystemManaged": {"type": "boolean"},
            "allowOwnerProject": {"type": "boolean"}
          }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["cli", "skills", "agent"]},
        "name": {"type": "string", "minLength": 1},
        "names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "command": {"type": "string", "minLength": 1},
        "args": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input"],
      "properties": {
        "input": {"type": "string", "minLength": 1},
        "promptParameter": {"type": "string", "minLength": 1},
        "metadataKey": {"type": "string", "minLength": 1},
        "valueType": {"enum": ["text", "boolean", "single", "multiple", "url-list"]},
        "transform": {"enum": ["trim", "string-list", "url-list"]},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "producer": {"enum": ["field-output", "frontend-computed", "runtime-defaulted"]},
        "required": {"type": "boolean"}
      },
      "anyOf": [{"required": ["promptParameter"]}, {"required": ["metadataKey"]}]
    },
    "sceneRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sceneKey"],
      "properties": {
        "sceneKey": {"type": "string", "minLength": 1},
        "titleKey": {"type": "string"},
        "summaryKey": {"type": "string"},
        "descriptionKey": {"type": "string"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "strategy"],
      "properties": {
        "schemaVersion": {"type": "string", "pattern": "^1\\."},
        "strategy": {"enum": ["declarative", "extension"]},
        "extensionPoint": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"}
      },
      "allOf": [
        {"if": {"properties": {"strategy": {"const": "extension"}}}, "then": {"required": ["extensionPoint"]}},
        {"if": {"properties": {"strategy": {"const": "declarative"}}}, "then": {"not": {"required": ["extensionPoint"]}}}
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deprecatedInputs": {"type": "array", "items": {"$ref": "#/$defs/compatibilityInput"}}
      }
    },
    "compatibilityInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legacy", "binding", "diagnosticCode"],
      "properties": {
        "legacy": {"type": "string", "minLength": 1},
        "binding": {"type": "string", "minLength": 1},
        "diagnosticCode": {"type": "string", "minLength": 1}
      }
    }
  }
}
