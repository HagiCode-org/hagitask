{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tasks.hagicode.com/schemas/community-index-v1.schema.json",
  "title": "HagiTask Community Index v1",
  "description": "Lightweight, machine-readable discovery contract for community HagiTask entries. Every document published at /index.json MUST conform to this schema. It carries only discovery and acquisition metadata; executable detail lives in the standalone detail documents.",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "publisher", "tasks"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Protocol version. Independent from any task package version."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp when this index document was produced by the build."
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "description": "Organization or team publishing the community catalog."
    },
    "source": {
      "type": "string",
      "description": "Optional root URL or repository reference for the catalog source."
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/taskEntry" }
    }
  },
  "$defs": {
    "taskEntry": {
      "type": "object",
      "required": [
        "taskId",
        "name",
        "summary",
        "category",
        "tags",
        "publisher",
        "source",
        "version",
        "publishedAt",
        "detailUrl",
        "packageUrl",
        "compatibility",
        "integrity"
      ],
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Canonical, stable package identifier. Human-facing aliases MUST NOT be emitted as additional task IDs."
        },
        "name": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 },
          "description": "Localized display name keyed by locale code (e.g. \"en-US\")."
        },
        "summary": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 },
          "description": "Localized short summary keyed by locale code."
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "description": "Primary discovery category used by the listing filters."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Secondary discovery tags."
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "description": "Publisher of this specific task entry."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Source reference for this entry (repository or catalog root)."
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Semver-like package version copied from the HagiTask manifest."
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time",
          "description": "RFC 3339 timestamp of the task publication."
        },
        "detailUrl": {
          "type": "string",
          "pattern": "^/tasks/[a-z0-9][a-z0-9-]*\\.json$",
          "description": "Stable public path to the standalone detail document."
        },
        "packageUrl": {
          "type": "string",
          "pattern": "^/packages/[a-z0-9][a-z0-9-]*\\.zip$",
          "description": "Stable public path to the downloadable package archive."
        },
        "compatibility": { "$ref": "#/$defs/compatibility" },
        "integrity": { "$ref": "#/$defs/integrity" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string",
          "description": "Required agent capability name, or \"any\"."
        },
        "skills": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Required skill names."
        },
        "cli": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "command": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } }
            }
          },
          "description": "Required CLI tooling."
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": ["sha256"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "sha256" },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Lowercase SHA-256 digest of the exact published package archive bytes."
        }
      }
    }
  }
}
